# Leave DATABASE_URL empty to use local SQLite (internpilot.db). For Supabase use the
# "Session pooler" connection string from Project Settings → Database.
DATABASE_URL=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
# AI (free tiers only, see config/settings.yaml → llm). Never add a payment method to either account.
# console.groq.com → API Keys
GROQ_API_KEY=
# aistudio.google.com → Get API key, in a Google Cloud project WITHOUT billing
GEMINI_API_KEY=
# From @BotFather; get CHAT_ID with: .venv/bin/python scripts/telegram_chat_id.py
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DASHBOARD_URL=

# Recruiter email lookup (free 25 searches/month: hunter.io)
HUNTER_API_KEY=
# Outreach stays a dry run (writes outbox/*.eml) until you set this to 0
DRY_RUN=1
# Gmail OAuth files (see SETUP_TONIGHT.md); defaults shown
# GMAIL_CREDENTIALS=secrets/gmail_credentials.json
# GMAIL_TOKEN=secrets/gmail_token.json
